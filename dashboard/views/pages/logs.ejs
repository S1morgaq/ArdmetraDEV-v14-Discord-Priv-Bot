<%- include('../partials/head') %>
<%- include('../partials/guildHead', { heading: 'Logs' }) %>

<div class="tabs">
  <a href="?" class="<%= category ? '' : 'active' %>">All</a>
  <% categories.forEach(function (c) { %><a href="?category=<%= c %>" class="<%= category === c ? 'active' : '' %>"><%= c %></a><% }) %>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Time (UTC)</th><th>Category</th><th>Event</th><th>Executor</th><th>Action taken</th></tr></thead>
      <tbody>
        <% if (logs.items.length === 0) { %><tr><td colspan="5" class="muted">No log entries.</td></tr><% } %>
        <% logs.items.forEach(function (l) { %>
          <tr>
            <td class="muted small"><%= new Date(l.createdAt).toISOString().replace('T', ' ').slice(0, 19) %></td>
            <td><span class="badge"><%= l.category %></span></td>
            <td><strong><%= l.title %></strong><% if (l.description) { %><div class="muted small"><%= l.description.slice(0, 160) %></div><% } %></td>
            <td><%= l.executorId || '—' %></td>
            <td class="small"><%= l.actionTaken || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="pager">
    <% const q = category ? '&category=' + category : ''; %>
    <% if (logs.page > 1) { %><a class="btn small" href="?page=<%= logs.page - 1 %><%= q %>">← Prev</a><% } %>
    <span class="muted small">Page <%= logs.page %> / <%= logs.pages %> · <%= logs.total %> entries</span>
    <% if (logs.page < logs.pages) { %><a class="btn small" href="?page=<%= logs.page + 1 %><%= q %>">Next →</a><% } %>
  </div>
</div>
<%- include('../partials/foot') %>
